      },
      "id": "89dced13-72e6-4cc7-bc44-374b8f5b19a6",
      "name": "Submit proof to Elysia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 80]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst status = response.statusCode ?? 200;\nif ([401, 403, 404, 409].includes(status) || status >= 500) throw new Error(`Elysia proof submission failed with ${status}`);\nconst body = response.body ?? response;\nconst sendResponse = status >= 400;\nreturn [{ json: { sendResponse, text: sendResponse ? 'I could not accept that receipt. Check that the Hold ID is yours and still active, then try again with a JPEG, PNG, WebP, or PDF.' : body.text } }];"
      },
