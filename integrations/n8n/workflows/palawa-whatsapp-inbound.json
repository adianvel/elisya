      "name": "Run Elysia assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 360]
    },
    {
      "parameters": {
        "jsCode": "const event = $('WAHA inbound').first().json.body;\nconst caption = String(event.payload.body ?? '');\nconst holdId = caption.match(/\\b[0-9A-HJKMNP-TV-Z]{26}\\b/i)?.[0]?.toUpperCase() ?? '';\nconst mediaUrl = typeof event.payload.media?.url === 'string' ? event.payload.media.url : '';\nconst text = !holdId ? 'Please send the Hold ID in the image caption (for example, Hold <ID>) so I can match your receipt.' : 'I could not download that receipt. Please send the image or PDF again in a moment.';\nreturn [{ json: { holdId, mediaUrl, ready: Boolean(holdId && mediaUrl), text } }];"
      },
      "id": "14ce80ac-3d2d-4d4d-8963-62c0fc082123",
      "name": "Extract Hold ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 160]
    },
