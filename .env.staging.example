# Staging uses SSH tunnels instead of the public Caddy profile.
APP_DOMAIN=localhost
API_DOMAIN=localhost
APP_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:8100
WEB_HOST_PORT=3100
API_HOST_PORT=8100
N8N_HOST_PORT=16789
WAHA_HOST_PORT=13000
N8N_EDITOR_BASE_URL=http://127.0.0.1:16789/

# Generate independent values with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
PALAWA_DB_PASSWORD=replace-me
N8N_DB_PASSWORD=replace-me
BACKUP_DB_PASSWORD=replace-me
BETTER_AUTH_SECRET=replace-me
N8N_ENCRYPTION_KEY=replace-me
N8N_WEBHOOK_SECRET=replace-me
WAHA_API_KEY=replace-me
WAHA_WEBHOOK_SECRET=replace-me

PALAWA_ORGANIZATION_ID=replace-me
PALAWA_OWNER_WHATSAPP_NUMBER=628123456789

# Use a private staging COS bucket and staging-only key.
S3_ENDPOINT=https://cos.ap-jakarta.myqcloud.com
S3_REGION=ap-jakarta
S3_BUCKET=palawa-staging-proofs-APPID
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

BACKUP_S3_ENDPOINT=https://cos.ap-jakarta.myqcloud.com
BACKUP_S3_REGION=ap-jakarta
BACKUP_S3_BUCKET=palawa-staging-backups-APPID
BACKUP_S3_ACCESS_KEY=replace-me
BACKUP_S3_SECRET_KEY=replace-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM="Palawa Staging <noreply@example.com>"
TECHNICAL_OPERATOR_EMAIL=ops@example.com
AI_GATEWAY_API_KEY=replace-me
